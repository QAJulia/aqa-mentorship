<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>java-aqa-mentorship-week11</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <rest-assured.version>5.4.0</rest-assured.version>
        <jackson.version>2.15.2</jackson.version>
        <testng.version>7.8.0</testng.version>
        <allure.version>2.25.0</allure.version>
        <aspectj.version>1.9.20.1</aspectj.version>
        <lombok.version>1.18.30</lombok.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.11</logback.version>
        <surefire.version>3.1.2</surefire.version>

        <!--
            Default suite file – overridable from command line:
              mvn test -Dsuite=testng-week11-smoke.xml
        -->
        <suite>testng-week11-parallel.xml</suite>
    </properties>

    <dependencies>

        <!-- REST Assured core -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- JSON Schema Validator (Week 10+) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Allure TestNG integration -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Allure REST Assured filter -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                maven-surefire-plugin – Test runner.

                Key Week 11 additions:
                  • ${suite} property lets the CI (or developer) swap the XML without
                    editing the POM: mvn test -Dsuite=testng-week11-smoke.xml
                  • parallel / threadCount controlled inside each XML file
                    (TestNG's approach is to declare parallelism in the suite XML,
                     not in Surefire, so Surefire just hands off to TestNG)
                  • forkCount=1 reuseForks=true: single JVM, threads inside it
                    (safest for REST-Assured which is not always thread-safe by default
                     when using RestAssured.given(); our code avoids static state so
                     thread-local RequestSpecFactory is safe)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/${suite}</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- AspectJ weaver for Allure annotations -->
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <!-- Tell Allure where to store raw results -->
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                    <!-- Keep JVM alive for parallel threads (default: true, explicit for clarity) -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Allure Maven report generator -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.12.0</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        MAVEN PROFILES – Week 11 addition
        ═══════════════════════════════════════════════════════════════════════

        A Maven Profile activates a set of configuration overrides.
        Developers and CI pipelines activate them with:  mvn test -Psmoke

        Why profiles instead of just -Dsuite=... ?
          • Profiles can bundle multiple settings: suite file + system properties
            (e.g. -Dui.headless=true for CI) in one activation flag.
          • They are documented in the POM — a new developer can do:
              mvn help:all-profiles -f week11/pom.xml
            and immediately see what's available.

        Available profiles:
          smoke       → runs testng-week11-smoke.xml (fast, 2 threads)
          regression  → runs testng-week11-regression.xml (all groups, 4 threads)
          parallel    → runs testng-week11-parallel.xml (default, 3 threads)
          ci          → smoke + force headless (for GitHub Actions)
    -->
    <profiles>

        <!-- mvn test -Psmoke -->
        <profile>
            <id>smoke</id>
            <properties>
                <suite>testng-week11-smoke.xml</suite>
            </properties>
        </profile>

        <!-- mvn test -Pregression -->
        <profile>
            <id>regression</id>
            <properties>
                <suite>testng-week11-regression.xml</suite>
            </properties>
        </profile>

        <!-- mvn test -Pparallel  (default suite) -->
        <profile>
            <id>parallel</id>
            <properties>
                <suite>testng-week11-parallel.xml</suite>
            </properties>
        </profile>

        <!--
            mvn test -Pci
            Used by GitHub Actions – same as smoke but ensures headless and
            passes the Allure results dir explicitly.
        -->
        <profile>
            <id>ci</id>
            <properties>
                <suite>testng-week11-smoke.xml</suite>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire.version}</version>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>src/test/resources/${suite}</suiteXmlFile>
                            </suiteXmlFiles>
                            <argLine>
                                -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                            </argLine>
                            <systemPropertyVariables>
                                <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                                <ui.headless>true</ui.headless>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
