{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BooksListResponse",
  "description": "JSON Schema for GET /BookStore/v1/Books response",
  "type": "object",
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "description": "List of books in the BookStore catalogue",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Book"
      }
    }
  },
  "additionalProperties": false,

  "definitions": {
    "Book": {
      "type": "object",
      "description": "A single book in the catalogue",
      "required": ["isbn", "title", "subTitle", "author", "publish_date", "publisher", "pages", "description", "website"],
      "properties": {
        "isbn": {
          "type": "string",
          "description": "International Standard Book Number",
          "minLength": 10
        },
        "title": {
          "type": "string",
          "description": "Full title of the book",
          "minLength": 1
        },
        "subTitle": {
          "type": "string",
          "description": "Subtitle or tagline"
        },
        "author": {
          "type": "string",
          "description": "Author name(s)",
          "minLength": 1
        },
        "publish_date": {
          "type": "string",
          "description": "Publication date (ISO 8601 format)"
        },
        "publisher": {
          "type": "string",
          "description": "Name of the publisher"
        },
        "pages": {
          "type": "integer",
          "description": "Total number of pages",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "description": "Short description of the book"
        },
        "website": {
          "type": "string",
          "description": "URL to the book's website or resource",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  }
}
