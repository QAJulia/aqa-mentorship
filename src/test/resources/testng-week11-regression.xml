<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    testng-week11-regression.xml
    ══════════════════════════════════════════════════════════════════════════════
    FULL REGRESSION suite – run on merge to main / nightly.

    Includes every group: smoke + regression + api + schema + spec + contract
    + performance + model + books-list + single-book.

    Parallel:
      parallel="methods" thread-count="4"
      Slightly higher concurrency for the nightly run where throughput matters more.

    Data-provider parallelism note:
      If you later add @DataProvider(parallel = true) tests, TestNG uses a separate
      thread pool for data providers. The thread-count here only governs @Test methods.
-->
<suite name="Week 11 – Full Regression" verbose="1"
       parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="API Functional Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <include name="api"/>
                <include name="contract"/>
                <include name="performance"/>
                <include name="model"/>
                <include name="books-list"/>
                <include name="single-book"/>
            </run>
        </groups>
        <classes>
            <class name="api.BooksApiTest"/>
        </classes>
    </test>

    <test name="Schema Validation Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <include name="schema"/>
                <include name="contract"/>
            </run>
        </groups>
        <classes>
            <class name="schema.SchemaValidationTest"/>
        </classes>
    </test>

    <test name="Spec Pattern Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <include name="spec"/>
                <include name="performance"/>
            </run>
        </groups>
        <classes>
            <class name="spec.RequestSpecTest"/>
        </classes>
    </test>

</suite>
