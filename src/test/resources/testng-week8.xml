<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Week 8 – Selenide" verbose="1" parallel="none">

    <!-- Allure TestNG listener – required for report generation -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- ===================================================================
         Smoke – critical path tests
         =================================================================== -->
    <test name="Smoke Tests">
        <classes>
            <class name="ui.LoginPageTest"/>
            <class name="ui.CheckboxesPageTest"/>
            <class name="ui.TablesPageTest"/>
            <class name="ui.DropdownPageTest"/>
        </classes>
    </test>

    <!-- ===================================================================
         Regression – all tests
         =================================================================== -->
    <test name="Regression Tests">
        <classes>
            <class name="ui.LoginPageTest"/>
            <class name="ui.CheckboxesPageTest"/>
            <class name="ui.TablesPageTest"/>
            <class name="ui.DropdownPageTest"/>
        </classes>
    </test>

</suite>
