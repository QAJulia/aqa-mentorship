<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<!--
  testng-week6.xml – Week 6 Test Suite
  ======================================
  Structure:
    - Suite contains two test groups: smoke and regression
    - Each group runs the same page classes but with different test priorities
    - Allure listener is registered here for automatic report generation

  Run:
    mvn clean test                          → full suite
    mvn clean test -Dgroups=smoke           → smoke tests only
    mvn clean test -Dtest=TablesPageTest    → single class
-->
<suite name="Week 6 – Advanced XPath and Page Object Model" verbose="1" parallel="none">

    <!-- Register Allure TestNG listener so results are written to target/allure-results -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="ui.LoginPageTest"/>
            <class name="ui.CheckboxesPageTest"/>
            <class name="ui.TablesPageTest"/>
            <class name="ui.DropdownPageTest"/>
        </classes>
    </test>

    <test name="Regression Tests">
        <classes>
            <class name="ui.LoginPageTest"/>
            <class name="ui.CheckboxesPageTest"/>
            <class name="ui.TablesPageTest"/>
            <class name="ui.DropdownPageTest"/>
        </classes>
    </test>

</suite>
