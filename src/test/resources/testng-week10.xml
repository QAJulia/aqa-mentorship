<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Week 10 – Advanced REST Assured and API Design" verbose="1" parallel="none">

    <!-- Allure TestNG listener – required for @Epic/@Feature/@Story to appear in report -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- ================================================================
         SMOKE – fast sanity check (run before every deployment)
         ================================================================ -->
    <test name="Smoke – BookStore API" group-by-instances="true">
        <classes>
            <class name="api.BooksApiTest"/>
        </classes>
    </test>

    <!-- ================================================================
         CONTRACT – HTTP contract + JSON schema validation
         ================================================================ -->
    <test name="Contract – HTTP &amp; Schema" group-by-instances="true">
        <classes>
            <class name="api.BooksApiTest"/>
            <class name="schema.SchemaValidationTest"/>
        </classes>
    </test>

    <!-- ================================================================
         SCHEMA – dedicated schema / structural validation
         ================================================================ -->
    <test name="Schema Validation" group-by-instances="true">
        <classes>
            <class name="schema.SchemaValidationTest"/>
        </classes>
    </test>

    <!-- ================================================================
         SPEC – RequestSpec / ResponseSpec reuse demonstration
         ================================================================ -->
    <test name="Spec Reuse" group-by-instances="true">
        <classes>
            <class name="spec.RequestSpecTest"/>
        </classes>
    </test>

    <!-- ================================================================
         PERFORMANCE – response-time assertions
         ================================================================ -->
    <test name="Performance" group-by-instances="true">
        <classes>
            <class name="api.BooksApiTest"/>
        </classes>
    </test>

    <!-- ================================================================
         REGRESSION – full suite (all groups)
         ================================================================ -->
    <test name="Full Regression" group-by-instances="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
                <include name="api"/>
                <include name="schema"/>
                <include name="spec"/>
                <include name="contract"/>
                <include name="performance"/>
            </run>
        </groups>
        <classes>
            <class name="api.BooksApiTest"/>
            <class name="schema.SchemaValidationTest"/>
            <class name="spec.RequestSpecTest"/>
        </classes>
    </test>

</suite>
